{
  "name": "@skseal/web",
  "version": "0.1.0",
  "description": "SKSeal client-side document signing with OpenPGP.js — keys never leave the browser",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "openpgp": "^6.0.0"
  },
  "peerDependencies": {
    "vue": "^3.4"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0",
    "@types/node": "^22",
    "typescript": "^5.4",
    "vite": "^5.0",
    "vitest": "^2.0",
    "vue": "^3.4",
    "vue-tsc": "^2.0"
  },
  "license": "MIT",
  "author": "smilinTux.org <hello@smilintux.org>",
  "repository": {
    "type": "git",
    "directory": "skseal/web"
  }
}
